# ---------------------------------------------------------------------------
# TJ Policy Debate — environment
#
# Copy to `.env` for local development. On Vercel these are set under
# Settings → Environment Variables instead; never commit a filled-in .env.
#
# Every variable is validated once at startup in lib/env.ts, so a missing or
# malformed value fails the deploy loudly rather than at the first request.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# PostgreSQL connection string. On Vercel Postgres / Neon / Supabase, use the
# pooled connection string for the app.
DATABASE_URL="postgresql://user:password@host:5432/tjpolicy?sslmode=require"

# --- Deployment ------------------------------------------------------------
# Public origin, no trailing slash. Used to build the OAuth redirect URI, to
# validate the Origin header on every mutation, and as the canonical/sitemap
# base. MUST be https:// in production or startup refuses to continue.
APP_URL="http://localhost:3000"

# 32+ byte random string. Signs the CSRF token and salts the stored IP hash.
# Generate with:  openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- Authentication --------------------------------------------------------
# "dev" enables a local-only account picker and is refused in production.
# "ion" uses the real TJ Intranet OAuth service.
AUTH_PROVIDER="dev"

# Required when AUTH_PROVIDER=ion. Register the app at
# https://ion.tjhsst.edu/oauth/applications/ with the redirect URI set to
# <APP_URL>/api/auth/callback
ION_CLIENT_ID=""
ION_CLIENT_SECRET=""
ION_BASE_URL="https://ion.tjhsst.edu"
ION_USE_PKCE="true"

# --- Officers --------------------------------------------------------------
# Comma-separated Ion usernames that always hold the OFFICER role. Re-applied
# at every sign-in, so adding someone here grants access at their next sign-in.
# It only ever promotes — it never demotes anyone.
OFFICER_USERNAMES=""

# --- Integrations ----------------------------------------------------------
MYSCHOOLBUCKS_URL="https://www.myschoolbucks.com/"
TABROOM_IMPORT_ENABLED="true"

# --- Analytics (optional) --------------------------------------------------
# Plausible: cookieless, stores no device identifier, so it needs no consent
# gate. Leave NEXT_PUBLIC_PLAUSIBLE_DOMAIN empty and no script is loaded at
# all — which is what keeps local and preview traffic out of the numbers.
#
# Set this to the domain exactly as registered in Plausible, e.g. tjpolicy.org
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# Only needed for a self-hosted Plausible or Umami instance. The origin of
# this URL is added to the Content-Security-Policy automatically (proxy.ts).
# Defaults to https://plausible.io/js/script.js when unset.
NEXT_PUBLIC_PLAUSIBLE_SRC=""

# --- Email (optional) -------------------------------------------------------
# Published news posts are emailed to every active member and their parent
# through Resend (HTTP API — Cloudflare Workers cannot use SMTP). Leave the key
# empty and publishing still works; the editor says nothing was sent.
#
# On Cloudflare this is a SECRET, never a var in wrangler.jsonc:
#   npx wrangler secret put RESEND_API_KEY
RESEND_API_KEY=""
# The domain must be verified in Resend (DNS records on tjpolicy.org), or every
# send is rejected.
EMAIL_FROM="TJ Policy Debate <news@tjpolicy.org>"
EMAIL_REPLY_TO="tjhsstpolicy1@gmail.com"
