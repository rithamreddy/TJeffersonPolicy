// TJHSST Policy Debate — data model
//
// Target: SQLite (local dev + small self-hosted deploys) or libSQL/Turso in
// production via a Prisma driver adapter. SQLite has no native enum or array
// types, so status/role columns are plain strings validated by the zod unions
// in lib/validation and the constant maps in lib/constants.ts, and list-valued
// columns store JSON text read through the helpers in lib/json.ts.
//
// Porting to PostgreSQL later requires only changing `provider` below and
// regenerating migrations; no column types are SQLite-specific.

generator client {
  provider   = "prisma-client-js"
  output     = "../node_modules/.prisma/client"
  engineType = "wasm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// A team member. Created on first successful sign-in through the configured
/// auth provider (Ion in production). `role` is the single source of truth for
/// authorization and is only ever read server-side.
model User {
  id             String  @id @default(cuid())
  /// Ion username, e.g. "2028rreddy". Stable primary identifier across years.
  ionUsername    String  @unique
  /// Numeric Ion user id, when the provider supplies one.
  ionUserId      Int?    @unique
  firstName      String
  lastName       String
  displayName    String
  /// School address. Seeded from Ion on first sign-in, then owned by the
  /// member: Ion only fills it while it is empty, so an edit is never
  /// overwritten at the next sign-in. Never public.
  tjEmail        String?
  /// The member's personal address. News emails go here (see
  /// lib/services/news-email.ts).
  contactEmail   String?
  /// The member's own phone. Also refreshed from their latest tournament
  /// registration, which asks for it fresh each time.
  phoneNumber    String?
  /// Parent or guardian contact. Officers use it for tournament logistics, and
  /// news emails are copied to parentEmail.
  parentEmail    String?
  parentPhone    String?
  graduationYear Int?
  gradeNumber    Int?
  /// "MEMBER" | "OFFICER"
  role           String  @default("MEMBER")
  /// "ACTIVE" | "INACTIVE" | "ALUMNI"
  status         String  @default("ACTIVE")
  /// JSON array of event codes, e.g. ["POLICY_VARSITY"]
  events         String  @default("[]")
  /// "UNKNOWN" | "NOT_MEMBER" | "PENDING" | "ACTIVE"
  nsdaStatus     String  @default("UNKNOWN")
  nsdaMemberId   String?
  /// Free-text partner preference shown to officers when pairing.
  partnerName    String?
  pictureUrl     String?

  /// Onboarding. Both start empty for everyone — existing members included —
  /// so every member sees the welcome tour once and the getting-started
  /// checklist until it is finished or dismissed. See lib/services/onboarding.ts.
  onboardingTourCompletedAt      DateTime?
  onboardingChecklistDismissedAt DateTime?

  firstSeenAt DateTime  @default(now())
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions      Session[]
  registrations TournamentRegistration[]
  dues          DuesRecord[]
  orders        Order[]
  awards        Award[]
  officer       OfficerProfile?
  newsPosts     NewsPost[]               @relation("NewsAuthor")
  resources     Resource[]               @relation("ResourceAuthor")
  auditEvents   AuditLog[]               @relation("AuditActor")
  tournaments   Tournament[]             @relation("TournamentCreator")
  duesUpdates   DuesRecord[]             @relation("DuesUpdatedBy")
  formsCreated  Form[]                   @relation("FormCreator")
  formResponses FormResponse[]

  @@index([role])
  @@index([status])
  @@index([graduationYear])
}

/// Server-side session. The browser only ever holds an opaque random token;
/// only its SHA-256 hash is stored, so a database leak cannot be replayed.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  userAgent  String?
  /// Truncated/hashed client address, kept only for audit-log correlation.
  ipHash     String?

  @@index([userId])
  @@index([expiresAt])
}

/// Short-lived record binding an in-flight OAuth authorization request to this
/// browser. Holds the PKCE verifier so it never travels to the client.
model AuthRequest {
  id           String   @id @default(cuid())
  state        String   @unique
  codeVerifier String
  nonce        String
  redirectTo   String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Tournaments
// ---------------------------------------------------------------------------

model Tournament {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  startDate    DateTime
  endDate      DateTime?
  location     String
  /// "LOCAL" | "REGIONAL" | "STATE" | "NATIONAL" | "ONLINE" | "SCRIMMAGE"
  circuit      String    @default("LOCAL")
  description  String?
  eligibility  String?
  /// Officer-only notes; never exposed on public or member endpoints.
  officerNotes String?
  /// Shown to members alongside the tournament.
  memberNotes  String?

  registrationOpensAt  DateTime?
  registrationDeadline DateTime?
  /// "DRAFT" | "OPEN" | "CLOSED" | "ARCHIVED"
  status               String    @default("DRAFT")

  externalRegistrationUrl String?
  tabroomUrl              String?
  /// Numeric Tabroom tournament id, used for the read-only metadata import.
  tabroomId               Int?
  tabroomSyncedAt         DateTime?

  createdById String?
  createdBy   User?    @relation("TournamentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  divisions     TournamentDivision[]
  registrations TournamentRegistration[]

  @@index([status])
  @@index([startDate])
}

/// An event/division a member can register for at a given tournament.
model TournamentDivision {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  /// Short label, e.g. "CX" or "NCX".
  code         String?
  feeCents     Int?
  capacity     Int?
  sortOrder    Int        @default(0)

  registrations TournamentRegistration[]

  @@unique([tournamentId, name])
  @@index([tournamentId])
}

model TournamentRegistration {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournamentId String
  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  divisionId   String
  division     TournamentDivision @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  /// "PENDING" | "WAITLISTED" | "REGISTERED". Withdrawing deletes the row
  /// rather than storing a fourth value — see lib/services/registrations.ts.
  status      String @default("PENDING")
  partnerName String

  // Collected fresh at every registration rather than read from the member's
  // profile, because officers need this exact snapshot for Tabroom entry and
  // day-of contact — a profile edited later should not silently rewrite what
  // was true when this tournament was entered.
  schoolEmail        String?
  tabroomEmail       String?
  phoneNumber        String?
  /// Grade at the time of registration, not read live from the profile.
  grade              Int?
  partnerSchoolEmail String?

  /// Note written by the member at registration time.
  memberNote  String?
  /// Officer-only note; never returned to the member.
  officerNote String?
  /// Whether this division's entry fee has been paid. Set only by an officer,
  /// from the member's profile — see lib/services/dues.ts for how this feeds
  /// into what a member is shown as still owing.
  feePaid     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, divisionId])
  @@index([tournamentId, status])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Money (tracking only — this application never touches payment instruments)
// ---------------------------------------------------------------------------

/// A per-season override for one member, not a ledger. What a member owes is
/// computed from their unpaid tournament fees and unpaid orders — see
/// lib/services/dues.ts — and reaches $0 as soon as every item is checked off
/// on their profile. This row exists only to excuse a member from paying at
/// all (a hardship waiver) and to leave the treasurer a note; most members
/// never have one.
model DuesRecord {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Season start year, e.g. 2026 for the 2026–27 season.
  seasonYear Int
  waived     Boolean @default(false)
  note       String?

  updatedById String?
  updatedBy   User?    @relation("DuesUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, seasonYear])
  @@index([seasonYear])
}

/// Catalog entry an officer can create without touching source code.
model OrderItem {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  priceCents    Int?
  /// "APPAREL" | "MERCH" | "MEMBERSHIP" | "OTHER"
  category      String   @default("MERCH")
  /// Where the member actually pays, e.g. the club's MySchoolBucks store.
  externalUrl   String?
  externalLabel String?
  /// JSON array of size options; empty means no size choice.
  sizes         String   @default("[]")
  /// False also serves as "archived": an item is only ever hard-deleted (see
  /// deleteOrderItem in lib/services/orders.ts) when no order references it;
  /// otherwise this is set to false to hide it while keeping order history.
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]
}

model Order {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId      String
  item        OrderItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity    Int       @default(1)
  size        String?
  /// "PENDING" | "WAITLISTED" | "REGISTERED"
  status      String    @default("PENDING")
  memberNote  String?
  officerNote String?
  /// Whether this order has been paid for. Set only by an officer, from the
  /// member's profile — see lib/services/dues.ts.
  paid        Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Public content
// ---------------------------------------------------------------------------

model Achievement {
  id             String   @id @default(cuid())
  title          String
  tournamentName String
  /// Season start year, e.g. 2025 for the 2025–26 season.
  seasonYear     Int
  placement      String
  eventName      String?
  description    String?
  /// JSON array of participant display names.
  participants   String   @default("[]")
  /// "NATIONAL" | "STATE" | "REGIONAL" | "LOCAL" | "INVITATIONAL"
  level          String   @default("LOCAL")
  isFeatured     Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  awards Award[]

  @@index([seasonYear])
  @@index([isFeatured])
}

/// An award attributed to one member. Optionally derived from a public
/// Achievement so the two stay linked without duplicating text.
model Award {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId  String?
  achievement    Achievement? @relation(fields: [achievementId], references: [id], onDelete: SetNull)
  title          String
  tournamentName String?
  placement      String?
  awardedOn      DateTime
  createdAt      DateTime     @default(now())

  @@index([userId])
}

model NewsPost {
  id         String  @id @default(cuid())
  title      String
  slug       String  @unique
  excerpt    String
  /// Markdown-subset body rendered by lib/markdown.ts (no raw HTML).
  body       String
  imageUrl   String?
  /// "DRAFT" | "PUBLISHED"
  status     String  @default("DRAFT")
  /// "PUBLIC" — on the public site and in the portal.
  /// "MEMBERS" — portal only; never listed publicly or in the sitemap.
  visibility String  @default("PUBLIC")
  /// JSON array of tag strings.
  tags       String  @default("[]")

  authorId    String?
  author      User?     @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt DateTime?

  /// Set when the email to members is claimed for sending, and kept once it
  /// succeeds. It is the idempotency guard: a post is only ever emailed once,
  /// however many times it is edited or re-published. Cleared again if the
  /// send fails outright, so an officer can retry.
  emailedAt           DateTime?
  /// How many addresses the last send reached.
  emailRecipientCount Int?
  /// Why the last send failed or only partly succeeded, shown in the editor.
  emailError          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([status, visibility, publishedAt])
}

model OfficerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position    String
  bio         String?
  photoUrl    String?
  /// Address the officer has agreed to publish. Distinct from tjEmail.
  publicEmail String?
  /// JSON array of event codes shown on the public card.
  events      String   @default("[]")
  /// Season start year this officer term belongs to.
  termYear    Int
  isPublic    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([termYear, isPublic])
}

// ---------------------------------------------------------------------------
// Member resources
// ---------------------------------------------------------------------------

model Resource {
  id          String  @id @default(cuid())
  title       String
  description String?
  /// "EVIDENCE" | "CASES" | "RESEARCH" | "THEORY" | "STRATEGY" | "GUIDES" | "TEMPLATES" | "EXTERNAL"
  category    String
  url         String
  /// JSON array of tag strings.
  tags        String  @default("[]")
  /// "MEMBER" | "OFFICER" — resources are never public.
  visibility  String  @default("MEMBER")

  addedById String?
  addedBy   User?    @relation("ResourceAuthor", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([visibility])
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

/// Officer-editable club facts (contact address, socials, dues amount, links).
/// Keeps content changes out of the source tree.
model ClubSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Append-only record of administrative actions. Rows are never updated.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// Denormalised actor label so history survives account deletion.
  actorLabel String
  action     String
  targetType String
  targetId   String?
  summary    String
  /// JSON object with action-specific details (never secrets or PII beyond names).
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Forms
// ---------------------------------------------------------------------------

/// An officer-built form members fill in — permission slips, t-shirt sizes,
/// availability for a tournament weekend.
model Form {
  id          String    @id @default(cuid())
  title       String
  description String?
  /// "DRAFT" — officers only. "OPEN" — members can answer. "CLOSED" — read-only.
  status      String    @default("DRAFT")
  /// Optional hard stop. After it passes the form behaves as CLOSED even if the
  /// status still says OPEN, so nobody has to remember to flip it at midnight.
  closesAt    DateTime?

  createdById String?
  createdBy   User?   @relation("FormCreator", fields: [createdById], references: [id], onDelete: SetNull)

  fields    FormField[]
  responses FormResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, closesAt])
}

/// One question. Answers are keyed by this row's id, which is why a form's
/// questions are locked — apart from label and help text — once anyone has
/// answered: deleting or retyping a question would orphan answers already given.
model FormField {
  id       String  @id @default(cuid())
  formId   String
  form     Form    @relation(fields: [formId], references: [id], onDelete: Cascade)
  position Int
  /// See FORM_FIELD_TYPES in lib/constants.ts.
  type     String
  label    String
  helpText String?
  required Boolean @default(false)
  /// JSON array of choice strings, for the three choice types. "[]" otherwise.
  options  String  @default("[]")

  @@index([formId, position])
}

/// One member's answers to one form. A member has at most one response per
/// form and may edit it until the form closes.
model FormResponse {
  id      String @id @default(cuid())
  formId  String
  form    Form   @relation(fields: [formId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// JSON object: field id → string, or string[] for checkbox questions.
  /// Validated against the form's questions in lib/services/forms.ts.
  answers String @default("{}")

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([formId, userId])
  @@index([userId])
}
